rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Steno dictation audio: anyone can listen (students, visitors),
    // but only a logged-in admin can upload/replace/delete.
    match /stenoAudio/{category}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Everything else stays locked to logged-in users only (safe default).
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
